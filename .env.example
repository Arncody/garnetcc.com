# Copy to .env locally or configure these as hosting environment variables.
# Generate a unique key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=REPLACE_WITH_OUTPUT_OF_SECRET_GENERATOR
DEBUG=False
ALLOWED_HOSTS=your-domain.example,www.your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example,https://www.your-domain.example
SECURE_SSL_REDIRECT=True
# Start with HSTS disabled/short. Increase only after HTTPS is verified on every hostname.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
# Set True only if the host confirms it sends X-Forwarded-Proto safely.
USE_X_FORWARDED_PROTO=False\nTRUST_PROXY_HEADERS=False
DB_ENGINE=sqlite
# For PostgreSQL, use DB_ENGINE=postgres and configure DB_NAME/USER/PASSWORD/HOST/PORT.
DB_NAME=garnet_db
DB_USER=garnet_user
DB_PASSWORD=REPLACE_ME
DB_HOST=localhost
DB_PORT=5432
PROTECT_MEDIA=True
# Leave empty on shared hosting unless the host explicitly supports internal redirect.
MEDIA_ACCEL_REDIRECT=
